<!-- Mounted into /etc/clickhouse-server/config.d/: ClickHouse's built-in Prometheus
     endpoint (no exporter container needed). Scraped by Prometheus on :9363/metrics. -->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <errors>true</errors>
    </prometheus>
</clickhouse>
