{
  "uid": "tsetmc-collector",
  "title": "TSETMCViewer · دریافت داده",
  "description": "حلقه‌ی دقیقه‌ای، منبع TSETMC و کیفیت",
  "tags": [
    "tsetmc-viewer"
  ],
  "timezone": "Asia/Tehran",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "وضعیت",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "رهبر",
      "description": "تعداد نمونه‌هایی که lease را دارند؛ باید ۱ باشد",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(tsetmc_collector_leader)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              },
              {
                "value": 2,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "جلسه تأیید شد",
      "description": "TSETMC معاملات امروز را نشان می‌دهد",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 3,
      "targets": [
        {
          "refId": "A",
