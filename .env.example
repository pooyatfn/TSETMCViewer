# Copy to .env and adjust. Every setting has a sensible default.

# --- ClickHouse ---
# Overridden to "clickhouse" inside docker compose.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=tsetmc
CLICKHOUSE_DATABASE=tsetmc
# Replication (ADR 0011), off by default. Set to "tsetmc_cluster" only when running
# `docker compose --profile ha-storage up`; leave unset for the plain single-node setup.
#CLICKHOUSE_CLUSTER=tsetmc_cluster

# --- Redis: response cache + tick events (empty = disabled, API reads ClickHouse directly) ---
# Overridden to redis://redis:6379/0 inside docker compose.
REDIS_URL=redis://localhost:6379/0

# --- Data sources ---
TSETMC_BASE_URL=https://cdn.tsetmc.com/api

# --- HTTP behaviour ---
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_MAX_CONCURRENCY=8
# Outbound proxy, if TSETMC must be reached through one (httpx honours these):
# HTTPS_PROXY=http://host.docker.internal:8080

# --- Collector ---
COLLECT_INTERVAL_SECONDS=60
# true = also collect outside market hours (development / demo)
COLLECT_IGNORE_MARKET_HOURS=false
# Off-hours start: load daily history + a closing snapshot of the last session (panel not empty)
COLLECT_BOOTSTRAP=true
# Rebuild minutes missed before a late start from today's trades (ADR 0012)
INTRADAY_BACKFILL=true
# At boot: rebuild this many recent trading days of minute data from price history,
# checked against the official daily rollup (ADR 0013). 0 disables it.
SESSION_BACKFILL_DAYS=5
HISTORY_MAX_DAYS=400
# Liveness file for `tsetmc-viewer healthcheck`; one ERROR after N consecutive failed cycles
# COLLECTOR_HEARTBEAT_PATH=/tmp/tsetmc-collector-heartbeat.json
# COLLECTOR_ALERT_AFTER_FAILURES=3
# Prometheus metrics of the collector (0 = off); the API serves /metrics itself
COLLECTOR_METRICS_PORT=9108
# Leader lease (s) so several collector replicas can run with one active (0 = off)
COLLECTOR_LEADER_LEASE_SECONDS=60

# --- Market calendar (Asia/Tehran) ---
MARKET_OPEN_TIME=09:00
MARKET_CLOSE_TIME=12:30
# MARKET_TIMEZONE=Asia/Tehran
# Python weekday numbers (Mon=0 … Sat=5, Sun=6); default Saturday–Wednesday
# MARKET_TRADING_WEEKDAYS=[5,6,0,1,2]
# Official holidays close the market (list in src/tsetmc_viewer/domain/calendar.py)
MARKET_HOLIDAYS=true
# One-off closures announced by the exchange (JSON object date → reason)
# MARKET_EXTRA_HOLIDAYS={"2026-10-05": "تعطیلی اعلام‌شده توسط بورس"}
# No trade by open + N minutes on a listed trading day → recorded as a closure
MARKET_SESSION_GUARD_MINUTES=20

# --- Data-quality thresholds (docs/04-data-quality.md) ---
VALIDATION_NAV_STALE_MINUTES=20
VALIDATION_NAV_JUMP_RATIO=0.10
VALIDATION_CLIENT_MISMATCH_RATIO=0.02
VALIDATION_MAX_GAP_FILL_MINUTES=30
VALIDATION_FEED_STALE_CYCLES=3

# --- Logging / API ---
LOG_LEVEL=INFO
LOG_JSON=false
API_PORT=8000
# API worker processes (docker compose sets 2)
API_WORKERS=1
WEB_PORT=8080   # user panel (nginx: static bundle + /api proxy)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Monitoring (docker compose --profile monitoring up -d; docs/11-monitoring.md) ---
GRAFANA_PORT=3000          # http://localhost:3000 (login below)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin     # change it
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
ALERTMANAGER_PORT=9093
COLLECTOR_REPLICAS=2       # one leads, the others stand by

# --- Alert delivery (all optional; without any, alerts are only logged by alert-relay) ---
# Bale (بله) bot — works inside Iran: create a bot with @botfather in Bale
ALERT_BALE_TOKEN=
ALERT_BALE_CHAT_ID=
# ALERT_BALE_API=https://tapi.bale.ai
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# ALERT_TELEGRAM_API=https://api.telegram.org
# Any HTTP endpoint that accepts Alertmanager's JSON (n8n, Slack bridge, ...)
ALERT_WEBHOOK_URL=
# Runbook links in messages point here
ALERT_DOCS_URL=http://localhost:8001
